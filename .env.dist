# Copy to .env and fill in. .env is git-ignored.

# Password of the "pi" user (SSH password login and sudo)
PI_PASSWORD=

# Public key allowed to log in as "pi" (copied into the image)
SSH_PUBKEY=

# Wi-Fi (WPA2-PSK). Leave WIFI_SSID empty to use Ethernet only.
# The passphrase is converted to a PSK hash at build time; it is not stored in the image.
WIFI_SSID=
WIFI_PSK=
# Regulatory domain, ISO 3166-1 alpha-2 country code
WIFI_COUNTRY=UA
