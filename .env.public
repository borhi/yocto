# Public image profile: no personal data, safe to publish.
#   ENV_FILE=.env.public OUT_DIR=deploy/public ./scripts/build.sh

# Well-known default password; it is expired, so it must be changed on first login
PI_PASSWORD=raspberry
PI_PASSWORD_EXPIRE=1

# No authorized SSH key: log in with the password
SSH_PUBKEY=none

# No Wi-Fi: Ethernet only (configure Wi-Fi after first login)
WIFI_SSID=
WIFI_PSK=
WIFI_COUNTRY=
