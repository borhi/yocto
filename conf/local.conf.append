
# ---------------- custom settings (rpi5-ssh-image) ----------------
MACHINE = "raspberrypi5"
DISTRO = "poky"

# Shared download / sstate caches (live in the Docker volume)
DL_DIR = "/work/downloads"
SSTATE_DIR = "/work/sstate-cache"

# Docker Desktop VM has ~8 GB RAM: keep parallelism moderate
BB_NUMBER_THREADS = "4"
PARALLEL_MAKE = "-j 4"

# No on-target package tests: *-ptest packages would pull python3, perl and a
# native gcc into the build, which is neither needed nor fits into 8 GB RAM
DISTRO_FEATURES:remove = "ptest"

# Enable meta-virtualization's distro integration (no packages added to the
# image yet: add docker-moby / podman / qemu etc. to IMAGE_INSTALL as needed)
DISTRO_FEATURES:append = " virtualization"

# ROS 2 Jazzy (the distro is selected by the meta-ros2-jazzy layer).
# ros-core doesn't need Fortran; skipping it avoids rebuilding gcc with gfortran.
ROS_WORLD_SKIP_GROUPS:append = " fortran"

# Save disk space
INHERIT += "rm_work"

# Raspberry Pi specifics
ENABLE_UART = "1"

# Boot chain: Pi firmware -> U-Boot (kernel_2712.img) -> boot.scr -> Linux Image.
# U-Boot 2025.01 comes from meta-custom; scarthgap's 2024.01 has no Pi 5 support.
RPI_USE_U_BOOT = "1"
PREFERRED_VERSION_u-boot = "2025.01%"
LICENSE_FLAGS_ACCEPTED = "synaptics-killswitch"
IMAGE_FSTYPES = "wic.bz2 wic.bmap tar.bz2"

# Identity
RPI_HOSTNAME = "rpi5-yocto"
hostname:pn-base-files = "${RPI_HOSTNAME}"
